:: =====================================================
::  CONFIRM + DISPATCH   (Y = apply, U = undo, N = cancel)
:: =====================================================
:run
cls
echo.
call :rainbow
echo.
echo   %ESC%[30;103m  %~2  %RS%
echo.
echo   %WH%%~3%RS%
if not "%~4"=="" echo   %GY%%~4%RS%
echo.
echo   %ESC%[30;102m Y %RS%  %GR%Yes, apply it%RS%
echo   %ESC%[30;103m U %RS%  %YL%Undo / revert it%RS%
echo   %ESC%[97;101m N %RS%  %RD%No, cancel%RS%
echo.
<nul set /p "=  %YL%--> %WH%Apply this tweak? Press Y, U or N: %RS%"
choice /c YUN /n >nul
echo.
if errorlevel 3 exit /b
if errorlevel 2 call :undo_%~1 & goto run_done
call :do_%~1
:run_done
echo.
echo   %GR%Finished.%RS% %GY%Press any key to continue...%RS%
pause >nul
exit /b

:: =====================================================
::  NETWORK ACTIONS
:: =====================================================
:do_flushdns
ipconfig /flushdns
exit /b
:undo_flushdns
echo No undo available for this tweak.
exit /b

:do_renewip
ipconfig /release >nul
ipconfig /renew
exit /b
:undo_renewip
echo No undo available for this tweak.
exit /b

:do_winsock
netsh winsock reset
exit /b
:undo_winsock
echo No undo available for this tweak.
exit /b

:do_tcpreset
netsh int ip reset
exit /b
:undo_tcpreset
echo No undo available for this tweak.
exit /b

:do_dnscf
powershell -NoProfile -Command "Get-NetAdapter | Where-Object Status -eq 'Up' | ForEach-Object { Set-DnsClientServerAddress -InterfaceIndex $_.ifIndex -ServerAddresses ('1.1.1.1','1.0.0.1') }"
exit /b
:undo_dnscf
powershell -NoProfile -Command "Get-NetAdapter | Where-Object Status -eq 'Up' | ForEach-Object { Set-DnsClientServerAddress -InterfaceIndex $_.ifIndex -ResetServerAddresses }"
exit /b

:do_dnsgoogle
powershell -NoProfile -Command "Get-NetAdapter | Where-Object Status -eq 'Up' | ForEach-Object { Set-DnsClientServerAddress -InterfaceIndex $_.ifIndex -ServerAddresses ('8.8.8.8','8.8.4.4') }"
exit /b
:undo_dnsgoogle
goto undo_dnscf

:do_tcptune
netsh int tcp set global autotuninglevel=normal
netsh int tcp set global rss=enabled
exit /b
:undo_tcptune
netsh int tcp set global autotuninglevel=normal
exit /b

:do_throttle
reg add "HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Multimedia\SystemProfile" /v NetworkThrottlingIndex /t REG_DWORD /d 4294967295 /f >nul
exit /b
:undo_throttle
reg add "HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Multimedia\SystemProfile" /v NetworkThrottlingIndex /t REG_DWORD /d 10 /f >nul
exit /b

:do_nagle
for /f "tokens=*" %%K in ('reg query "HKLM\SYSTEM\CurrentControlSet\Services\Tcpip\Parameters\Interfaces"') do (
    reg add "%%K" /v TcpAckFrequency /t REG_DWORD /d 1 /f >nul 2>&1
    reg add "%%K" /v TCPNoDelay /t REG_DWORD /d 1 /f >nul 2>&1
)
exit /b
:undo_nagle
for /f "tokens=*" %%K in ('reg query "HKLM\SYSTEM\CurrentControlSet\Services\Tcpip\Parameters\Interfaces"') do (
    reg delete "%%K" /v TcpAckFrequency /f >nul 2>&1
    reg delete "%%K" /v TCPNoDelay /f >nul 2>&1
)
exit /b

:do_adapterpower
powershell -NoProfile -Command "Get-NetAdapter -Physical | ForEach-Object { Disable-NetAdapterPowerManagement -Name $_.Name -ErrorAction SilentlyContinue }"
exit /b
:undo_adapterpower
powershell -NoProfile -Command "Get-NetAdapter -Physical | ForEach-Object { Enable-NetAdapterPowerManagement -Name $_.Name -ErrorAction SilentlyContinue }"
exit /b

:do_qos
reg add "HKLM\SOFTWARE\Policies\Microsoft\Windows\Psched" /v NonBestEffortLimit /t REG_DWORD /d 0 /f >nul
exit /b
:undo_qos
reg delete "HKLM\SOFTWARE\Policies\Microsoft\Windows\Psched" /v NonBestEffortLimit /f >nul 2>&1
exit /b

:do_dop2p
reg add "HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\DeliveryOptimization\Config" /v DODownloadMode /t REG_DWORD /d 0 /f >nul
exit /b
:undo_dop2p
reg add "HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\DeliveryOptimization\Config" /v DODownloadMode /t REG_DWORD /d 1 /f >nul
exit /b

