@echo off
title Rhett's PC Tweaks ^& Optimization
color 0F
mode con cols=80 lines=44
setlocal

:: ---------- Self-elevate to Administrator ----------
net session >nul 2>&1
if %errorlevel% neq 0 (
    powershell -NoProfile -Command "Start-Process -FilePath '%~f0' -Verb RunAs"
    exit /b
)

:: ---------- Color setup (ANSI) ----------
for /f %%E in ('echo prompt $E^| cmd') do set "ESC=%%E"
set "RS=%ESC%[0m"
set "RD=%ESC%[91m"
set "GR=%ESC%[92m"
set "YL=%ESC%[93m"
set "BL=%ESC%[94m"
set "MG=%ESC%[95m"
set "CY=%ESC%[96m"
set "WH=%ESC%[97m"
set "GY=%ESC%[90m"
set "BD=%ESC%[1m"

:main
cls
echo.
call :rainbow
echo.
echo     %BD%%MG%Rhett's %CY%PC Tweaks %YL%^& %GR%Optimization%RS%
echo     %GY%Pick an option with a single key press. Apply, undo or cancel any tweak.%RS%
echo.
echo   %ESC%[30;106m 1 %RS%  %CY%Network      %RS%%GY%DNS, latency, throttling%RS%
echo   %ESC%[97;101m 2 %RS%  %RD%CPU          %RS%%GY%Scheduling, core parking, boost%RS%
echo   %ESC%[30;102m 3 %RS%  %GR%GPU          %RS%%GY%HAGS, fullscreen, driver timeout%RS%
echo   %ESC%[97;105m 4 %RS%  %MG%Memory       %RS%%GY%RAM, paging, compression%RS%
echo   %ESC%[30;103m 5 %RS%  %YL%Performance  %RS%%GY%Ultimate plan and Rhett's Performance%RS%
echo   %ESC%[97;104m 6 %RS%  %BL%Gaming       %RS%%GY%Game Mode, DVR, mouse, priority%RS%
echo   %ESC%[30;107m 7 %RS%  %WH%Privacy      %RS%%GY%Telemetry, ads, suggestions%RS%
echo   %ESC%[30;43m 8 %RS%  %YL%Cleanup      %RS%%GY%Temp files, caches, SFC and DISM%RS%
echo.
echo   %ESC%[30;102m R %RS%  %GR%Create a System Restore Point %GY%(do this first)%RS%
echo   %ESC%[97;100m 0 %RS%  %GY%Exit%RS%
echo.
call :prompt
choice /c 12345678R0 /n >nul
set sel=%errorlevel%
if %sel%==1 goto menu_net
if %sel%==2 goto menu_cpu
if %sel%==3 goto menu_gpu
if %sel%==4 goto menu_mem
if %sel%==5 goto menu_perf
if %sel%==6 goto menu_game
if %sel%==7 goto menu_priv
if %sel%==8 goto menu_clean
if %sel%==9 call :run restorepoint "Create System Restore Point" "Creates a restore point so you can roll back. Windows allows one per 24 hours by default."
if %sel%==10 goto quit
goto main

:quit
echo %RS%
cls
exit /b

:: =====================================================
::  NETWORK
:: =====================================================
:menu_net
set "K=%ESC%[30;106m"
call :hdr "NETWORK" "Faster lookups, lower latency, less throttling"
echo   %K% A %RS%  %WH%Flush DNS cache%RS%
echo   %K% B %RS%  %WH%Release and renew IP%RS%
echo   %K% C %RS%  %WH%Reset Winsock %GY%(reboot needed)%RS%
echo   %K% D %RS%  %WH%Reset TCP/IP stack %GY%(reboot needed)%RS%
echo   %K% E %RS%  %WH%Use Cloudflare DNS 1.1.1.1%RS%
echo   %K% F %RS%  %WH%Use Google DNS 8.8.8.8%RS%
echo   %K% G %RS%  %WH%TCP auto-tuning normal + RSS on%RS%
echo   %K% H %RS%  %WH%Disable network throttling%RS%
echo   %K% I %RS%  %WH%Disable Nagle algorithm %GY%(lower latency)%RS%
echo   %K% J %RS%  %WH%Disable network adapter power saving%RS%
echo   %K% K %RS%  %WH%Remove QoS bandwidth reservation%RS%
echo   %K% L %RS%  %WH%Disable Delivery Optimization %GY%(P2P updates)%RS%
echo.
echo   %ESC%[97;100m 0 %RS%  %GY%Back to main menu%RS%
echo.
call :prompt
choice /c ABCDEFGHIJKL0 /n >nul
set sel=%errorlevel%
if %sel%==13 goto main
if %sel%==1  call :run flushdns "Flush DNS cache" "Clears the local DNS resolver cache. Fixes stale or broken lookups."
if %sel%==2  call :run renewip "Release and renew IP" "Drops your DHCP lease and requests a new one. Connection blips briefly."
if %sel%==3  call :run winsock "Reset Winsock" "Resets the Winsock catalog. Fixes odd connection problems. Needs a reboot."
if %sel%==4  call :run tcpreset "Reset TCP/IP stack" "Rewrites TCP/IP settings to defaults. Needs a reboot."
if %sel%==5  call :run dnscf "Cloudflare DNS" "Sets DNS on all active adapters to 1.1.1.1 and 1.0.0.1. Usually faster lookups."
if %sel%==6  call :run dnsgoogle "Google DNS" "Sets DNS on all active adapters to 8.8.8.8 and 8.8.4.4."
if %sel%==7  call :run tcptune "TCP auto-tuning and RSS" "Sets recommended receive window auto-tuning and enables receive-side scaling."
if %sel%==8  call :run throttle "Disable network throttling" "Removes the multimedia network throttle. Can help gaming and streaming."
if %sel%==9  call :run nagle "Disable Nagle algorithm" "Sends small packets immediately on all interfaces. Lowers latency in online games."
if %sel%==10 call :run adapterpower "Adapter power saving" "Stops Windows turning off your network adapters to save power."
if %sel%==11 call :run qos "Remove QoS reservation" "Sets reservable bandwidth limit to 0 percent."
if %sel%==12 call :run dop2p "Delivery Optimization" "Stops Windows sharing update downloads with other PCs over your connection."
goto menu_net

:: =====================================================
::  CPU
:: =====================================================
:menu_cpu
set "K=%ESC%[97;101m"
call :hdr "CPU" "Scheduling, core parking and boost behavior"
echo   %K% A %RS%  %WH%Foreground app CPU priority boost%RS%
echo   %K% B %RS%  %WH%Disable CPU core parking%RS%
echo   %K% C %RS%  %WH%Minimum processor state 100 percent%RS%
echo   %K% D %RS%  %WH%Disable Windows power throttling%RS%
echo   %K% E %RS%  %WH%Better multimedia and system responsiveness%RS%
echo   %K% F %RS%  %WH%Show CPU info%RS%
echo.
echo   %ESC%[97;100m 0 %RS%  %GY%Back to main menu%RS%
echo.
call :prompt
choice /c ABCDEF0 /n >nul
set sel=%errorlevel%
if %sel%==7 goto main
if %sel%==1 call :run prioritysep "CPU priority boost" "Gives the app you are using more CPU time slices. Undo restores the Windows default."
if %sel%==2 call :run parking "Disable core parking" "Keeps all CPU cores awake on the active plan (plugged in). Undo sets 10 percent."
if %sel%==3 call :run minproc "Minimum processor state 100 percent" "CPU stays at full speed on the active plan (plugged in). Runs hotter and uses more power."
if %sel%==4 call :run powerthrottle "Disable power throttling" "Stops Windows slowing down background apps to save power."
if %sel%==5 call :run sysresp "System responsiveness" "Reserves 0 percent of CPU for background multimedia tasks instead of 20 percent."
if %sel%==6 call :run cpuinfo "CPU info" "Shows your processor name, cores, threads and max clock speed."
goto menu_cpu

